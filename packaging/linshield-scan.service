[Unit]
Description=LinShield scheduled quick scan
Documentation=https://github.com/linshield/linshield

[Service]
Type=oneshot
ExecStart=/usr/local/bin/linshield scan --quick --quarantine
Nice=10
IOSchedulingClass=idle

# Hardening
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
